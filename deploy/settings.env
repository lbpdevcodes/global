# Settings for bin/refresh. Nothing secret: secrets are 1Password references in
# storage.env and rails.env, resolved by `op run` for the one command that needs them.

# Object storage (Linode, S3-compatible) for the database, backups and snapshots.
STORAGE_URL=s3://lbpdev/global/prod
AWS_ENDPOINT_URL=https://us-mia-1.linodeobjects.com
AWS_DEFAULT_REGION=us-mia-1

# Where alerts are opened as issues.
GITHUB_REPO=lbpdevcodes/global
