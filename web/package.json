{
  "name": "globe-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "fetch:snapshot": "scripts/fetch-snapshot.sh",
    "build:pages": "npm run fetch:snapshot && npm run check:coverage && npm run build",
    "preview": "wrangler pages dev build/client --port 4173 --compatibility-date=2026-10-23",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check:coverage": "node scripts/check-coverage.js",
    "lighthouse": "node scripts/lighthouse.js"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "downshift": "^9.4.0",
    "flag-icons": "^7.6.0",
    "globe.gl": "^2.46.2",
    "isbot": "^5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "mapshaper": "^0.7.100",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "fsevents": false,
    "better-sqlite3": false,
    "msgpackr-extract": false
  }
}
