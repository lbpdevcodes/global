#!/usr/bin/env bash
# Runs a command against the engine database kept in DATABASE_STORE:
#
#   DATABASE_STORE=s3://bucket/prefix   any S3-compatible store, through the aws CLI
#                                       (AWS_ENDPOINT_URL, AWS_DEFAULT_REGION and keys)
#   DATABASE_STORE=/some/directory      a local directory (development, tests)
#
# The database is fetched first, and uploaded back with a dated backup only
# when the command succeeds. A failed run leaves the stored copy untouched.
# The command itself never sees the storage keys.
set -euo pipefail

store="${DATABASE_STORE:?DATABASE_STORE must be set}"
database="${ENGINE_DATABASE:-storage/engine.sqlite3}"
export ENGINE_DATABASE="$database"

fetch() { # fetch <key> <destination>
  if [[ "$store" == s3://* ]]; then
    aws s3 cp --only-show-errors "$store/$1" "$2"
  else
    cp "$store/$1" "$2"
  fi
}

push() { # push <source> <key>
  if [[ "$store" == s3://* ]]; then
    aws s3 cp --only-show-errors "$1" "$store/$2"
  else
    mkdir -p "$(dirname "$store/$2")"
    cp "$1" "$store/$2"
  fi
}

rm -f "$database" "$database-wal" "$database-shm"
if ! fetch engine.sqlite3 "$database"; then
  if [[ "${ALLOW_EMPTY_DATABASE:-}" != "1" ]]; then
    echo "Could not fetch the stored database from $store; refusing to start from an empty one." >&2
    echo "Set ALLOW_EMPTY_DATABASE=1 only for the very first run." >&2
    exit 1
  fi
  echo "Starting from an empty database (ALLOW_EMPTY_DATABASE=1)." >&2
fi

env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY "$@"

workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT
sqlite3 "$database" "VACUUM INTO '$workdir/engine.sqlite3'"
push "$workdir/engine.sqlite3" "backups/engine-$(date -u +%Y%m%dT%H%M%SZ).sqlite3"
push "$workdir/engine.sqlite3" engine.sqlite3
